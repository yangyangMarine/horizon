# ==============================================================================
# Horizon: Macro Investor AI Expert Environment Configuration
# ==============================================================================

# LLM Provider Configuration
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional OpenAI Fallback (if switching provider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Application Security & Authentication
APP_ENV=development
AUTH_MODE=password
# Single-user credentials (hashed and stored securely in SQLite on first run)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_secure_password_123!
SESSION_SECRET=generate_a_random_32_byte_hex_string_for_production

# Paths & Storage
DATABASE_PATH=./data/app.db
EXPERT_PACKAGE_PATH=./expert_pack
INDEX_PATH=./data/index
TRANSCRIPT_PATH=./data/transcripts
AUDIO_PATH=./data/audio
EXPORT_PATH=./data/exports

# Cost & Token Guardrails
MAX_QUESTION_CHARACTERS=10000
MAX_OUTPUT_TOKENS=3000
MAX_CONTEXT_TOKENS=16000
MAX_REQUESTS_PER_MINUTE=10
DAILY_REQUEST_LIMIT=200
MONTHLY_BUDGET_USD=50.0
